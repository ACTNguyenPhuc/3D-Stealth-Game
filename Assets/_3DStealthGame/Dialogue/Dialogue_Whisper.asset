  nodes:
  - id: intro
    speaker: 
    text: "Ooooo... M\u1ED9t ng\u01B0\u1EDDi s\u1ED1ng... \u0111i l\u1EA1c v\xE0o \u0111\xE2y sao...?"
    onEnter: []
    choices:
    - text: "\u0110\u1EEBng s\u1EE3, t\xF4i kh\xF4ng l\xE0m h\u1EA1i ai."
      targetNodeId: calm
      conditions: []
      showWhenLocked: 1
      lockedHint: 
      actions: []
    - text: "Ivan g\u1EEDi l\u1EDDi h\u1ECFi th\u0103m b\u1EA1n."
      targetNodeId: ivan_friend
      conditions:
      - type: 0
        key: ivan_trust
        amount: 0
      showWhenLocked: 1
      lockedHint: "H\xE3y h\u1ECFi Ivan v\u1EC1 Whisper tr\u01B0\u1EDBc"
      actions: []
    - text: "B\xD9! Ma g\xEC m\xE0 nh\xE1t th\u1EBF!"
      targetNodeId: angry
      conditions: []
      showWhenLocked: 1
      lockedHint: 
      actions: []
    - text: "(L\u1EB7ng l\u1EBD r\u1EDDi \u0111i)"
      targetNodeId: 
      conditions: []
      showWhenLocked: 1
      lockedHint: 
      actions: []
    nextNodeId: 
  - id: calm
    speaker: 
    text: "Ta kh\xF4ng s\u1EE3... ta ch\u1EC9 c\xF4 \u0111\u01A1n. Nh\u1EEFng h\u1ED3n ma kh\xE1c kh\xF4ng hi\u1EC1n nh\u01B0 ta \u0111\xE2u."
    onEnter: []
    choices: []
    nextNodeId: calm_menu
  - id: calm_menu
    speaker: 
    text: "Ng\u01B0\u01A1i mu\u1ED1n g\xEC \u1EDF ta?"
    onEnter: []
    choices:
    - text: "B\u1EA1n c\xF3 th\u1EC3 gi\xFAp t\xF4i kh\xF4ng?"
      targetNodeId: help_refuse
      conditions:
      - type: 1
        key: ivan_trust
        amount: 0
      showWhenLocked: 0
      lockedHint: 
      actions: []
    - text: "Ivan g\u1EEDi l\u1EDDi h\u1ECFi th\u0103m b\u1EA1n."
      targetNodeId: ivan_friend
      conditions:
      - type: 0
        key: ivan_trust
        amount: 0
      showWhenLocked: 1
      lockedHint: "H\xE3y h\u1ECFi Ivan v\u1EC1 Whisper tr\u01B0\u1EDBc"
      actions: []
    - text: "M\u1EA3nh h\u1ED3n trong b\u1EBFp c\xF3 ai canh kh\xF4ng?"
      targetNodeId: kitchen_hint
      conditions:
      - type: 5
        key: kitchen_hint
        amount: 0
      showWhenLocked: 0
      lockedHint: 
      actions: []
    - text: "T\u1EA1m bi\u1EC7t."
      targetNodeId: 
      conditions: []
      showWhenLocked: 1
      lockedHint: 
      actions: []
    nextNodeId: 
  - id: help_refuse
    speaker: 
    text: "Gi\xFAp ng\u01B0\u01A1i? Ta c\xF2n ch\u1EB3ng bi\u1EBFt ng\u01B0\u01A1i l\xE0 ai..."
    onEnter: []
    choices: []
    nextNodeId: calm_menu
  - id: kitchen_hint
    speaker: 
    text: "M\u1ED9t h\u1ED3n ma \u0111i l\u1EA1i gi\u1EEFa b\u1EBFp v\xE0 ph\xF2ng kh\xE1ch. \u0110\u1EE3i n\xF3 quay l\u01B0ng... r\u1ED3i h\xE3y l\u1EA5y."
    onEnter: []
    choices: []
    nextNodeId: calm_menu
  - id: ivan_friend
    speaker: 
    text: "Ivan... ng\u01B0\u1EDDi l\xE0m v\u01B0\u1EDDn t\u1ED1t b\u1EE5ng... \u0110\u01B0\u1EE3c, v\xEC \xF4ng \u1EA5y, ta s\u1EBD gi\xFAp ng\u01B0\u01A1i m\u1ED9t l\u1EA7n."
    onEnter: []
    choices: []
    nextNodeId: help_choice
  - id: help_choice
    speaker: 
    text: "Ta c\xF3 th\u1EC3 l\xE0m m\u1ED9t trong ba vi\u1EC7c. Ch\u1ECDn \u0111i:"
    onEnter: []
    choices:
    - text: "L\xE0m l\u0169 ma ch\u1EADm l\u1EA1i."
