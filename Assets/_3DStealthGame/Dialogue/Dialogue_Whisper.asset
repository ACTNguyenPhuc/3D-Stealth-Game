        value: 1
        duration: 0
    nextNodeId: 
  - id: slow
    speaker: 
    text: "Ta s\u1EBD h\xE1t m\u1ED9t kh\xFAc ru cho ch\xFAng... \u0110i nhanh l\xEAn, ph\xE9p n\xE0y kh\xF4ng k\xE9o d\xE0i l\xE2u \u0111\xE2u!"
    onEnter: []
    choices: []
    nextNodeId: 
  - id: open
    speaker: 
    text: "C\xE1nh c\u1EEDa \u0111\u1ECF \u0111\xE3 m\u1EDF. Ch\xFAc ng\u01B0\u01A1i may m\u1EAFn, k\u1EBB s\u1ED1ng..."
    onEnter: []
    choices: []
    nextNodeId: 
  - id: energy
    speaker: 
    text: "H\xE3y nh\u1EADn l\u1EA5y \xE1nh s\xE1ng c\u1EE7a ta... v\xE0 m\u1ED9t ch\xFAt sinh l\u1EF1c."
